rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped Master Super-Admin Authority (creatergame31@gmail.com)
    function isPrimaryMasterAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'creatergame31@gmail.com';
    }

    // Role-Verified Staff Lookup on /admins/{uid}
    // Explicitly verifies document existence, targetUid binding, and that `data.role` is in `allowedRoles`.
    function hasStaffRole(allowedRoles) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.targetUid == request.auth.uid
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in allowedRoles;
    }

    // Tier 1: SUPER_ADMIN (Bootstrapped creatergame31@gmail.com or /admins/{uid} with role == 'SUPER_ADMIN')
    function isSuperAdmin() {
      return isPrimaryMasterAdmin() || hasStaffRole(['SUPER_ADMIN']);
    }

    // Tier 2: ADMIN (SUPER_ADMIN or /admins/{uid} with role == 'ADMIN')
    function isAdmin() {
      return isPrimaryMasterAdmin() || hasStaffRole(['SUPER_ADMIN', 'ADMIN']);
    }

    // Tier 3: GM / Game Master (SUPER_ADMIN, ADMIN, or /admins/{uid} with role == 'GM')
    function isGM() {
      return isPrimaryMasterAdmin() || hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'GM']);
    }

    // Tier 4: MODERATOR (SUPER_ADMIN, ADMIN, GM, or /admins/{uid} with role == 'MODERATOR')
    function isModerator() {
      return isPrimaryMasterAdmin() || hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'GM', 'MODERATOR']);
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: Video
    function isValidVideo(data) {
      return data.keys().hasAll([
          'title', 'description', 'category', 'resolution', 'videoUrl',
          'ownerId', 'authorName', 'ageRating', 'views', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'category', 'resolution', 'videoUrl',
          'ownerId', 'authorName', 'ageRating', 'views', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 1000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.resolution is string && data.resolution.size() >= 2 && data.resolution.size() <= 20
        && data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500
        && data.ownerId is string && isValidId(data.ownerId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.ageRating is string && data.ageRating.size() >= 3 && data.ageRating.size() <= 10
        && (data.ageRating == 'ALL' || data.ageRating == 'TEEN' || data.ageRating == 'MATURE')
        && data.views is number && data.views >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: Comment
    function isValidComment(data) {
      return data.keys().hasAll(['videoId', 'ownerId', 'authorName', 'text', 'createdAt'])
        && data.keys().hasOnly(['videoId', 'ownerId', 'authorName', 'text', 'createdAt'])
        && data.videoId is string && isValidId(data.videoId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: Playlist
    function isValidPlaylist(data) {
      return data.keys().hasAll(['name', 'ownerId', 'videoIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'ownerId', 'videoIds', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.videoIds is string && data.videoIds.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'isPremium', 'parentalControlMode',
          'lastWatchedVideoId', 'lastWatchedProgressSec', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'isPremium', 'parentalControlMode',
          'lastWatchedVideoId', 'lastWatchedProgressSec', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.isPremium is bool
        && data.parentalControlMode is bool
        && data.lastWatchedVideoId is string && data.lastWatchedVideoId.size() <= 128
        && data.lastWatchedProgressSec is number && data.lastWatchedProgressSec >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AdminRole
    function isValidAdminRole(data) {
      return data.keys().hasAll([
          'targetUid', 'email', 'role', 'permissions', 'assignedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'targetUid', 'email', 'role', 'permissions', 'assignedByUid', 'createdAt', 'updatedAt'
        ])
        && data.targetUid is string && isValidId(data.targetUid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.role is string && data.role.size() >= 2 && data.role.size() <= 20
        && (data.role == 'SUPER_ADMIN' || data.role == 'GM' || data.role == 'ADMIN' || data.role == 'MODERATOR')
        && data.permissions is string && data.permissions.size() >= 1 && data.permissions.size() <= 200
        && data.assignedByUid is string && isValidId(data.assignedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ModerationTicket
    function isValidModerationTicket(data) {
      return data.keys().hasAll([
          'ownerId', 'senderName', 'recipientEmail', 'category',
          'subject', 'message', 'status', 'adminReply', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'senderName', 'recipientEmail', 'category',
          'subject', 'message', 'status', 'adminReply', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 20
        && (data.category == 'ADMIN' || data.category == 'GM' || data.category == 'MODERATOR' || data.category == 'CONTACT')
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && data.status is string && data.status.size() >= 4 && data.status.size() <= 20
        && (data.status == 'OPEN' || data.status == 'IN_REVIEW' || data.status == 'RESOLVED')
        && data.adminReply is string && data.adminReply.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ContentReport
    function isValidContentReport(data) {
      return data.keys().hasAll([
          'targetId', 'targetType', 'targetTitle', 'reporterId', 'reporterName',
          'assignedAdminEmail', 'reason', 'severity', 'details', 'status',
          'resolutionNotes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'targetId', 'targetType', 'targetTitle', 'reporterId', 'reporterName',
          'assignedAdminEmail', 'reason', 'severity', 'details', 'status',
          'resolutionNotes', 'createdAt', 'updatedAt'
        ])
        && data.targetId is string && isValidId(data.targetId)
        && data.targetType is string && data.targetType.size() >= 4 && data.targetType.size() <= 20
        && (data.targetType == 'LUMEN_VIDEO' || data.targetType == 'STUDIO_STREAM' || data.targetType == 'COMMENT')
        && data.targetTitle is string && data.targetTitle.size() >= 1 && data.targetTitle.size() <= 160
        && data.reporterId is string && isValidId(data.reporterId)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80
        && data.assignedAdminEmail is string && data.assignedAdminEmail.size() >= 3 && data.assignedAdminEmail.size() <= 120
        && data.reason is string && data.reason.size() >= 4 && data.reason.size() <= 40
        && (data.reason == 'SPAM_OR_MISLEADING'
            || data.reason == 'HARASSMENT_OR_ABUSE'
            || data.reason == 'COPYRIGHT_OR_IP'
            || data.reason == 'AGE_RESTRICTION_VIOLATION'
            || data.reason == 'ENCODING_OR_PLAYBACK_ISSUE')
        && data.severity is string && data.severity.size() >= 3 && data.severity.size() <= 12
        && (data.severity == 'LOW' || data.severity == 'MEDIUM' || data.severity == 'HIGH' || data.severity == 'CRITICAL')
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 1000
        && data.status is string && data.status.size() >= 4 && data.status.size() <= 20
        && (data.status == 'OPEN' || data.status == 'IN_REVIEW' || data.status == 'ACTIONED' || data.status == 'DISMISSED')
        && data.resolutionNotes is string && data.resolutionNotes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Videos Collection
    match /videos/{videoId} {
      allow get: if isSignedIn() && isValidId(videoId) && existing().ageRating in ['ALL', 'TEEN', 'MATURE'];
      allow list: if isSignedIn() && existing().ageRating in ['ALL', 'TEEN', 'MATURE'];
      allow create: if isVerifiedUser()
        && isValidId(videoId)
        && isValidVideo(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(videoId)
        && isValidVideo(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1a: Owner or GM/Admin/SuperAdmin full metadata & ageRating update
          ((existing().ownerId == request.auth.uid || isGM())
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'resolution', 'ageRating', 'updatedAt']))
          ||
          // Action 1b: Moderator ageRating classification restriction only
          (isModerator()
            && incoming().diff(existing()).affectedKeys().hasOnly(['ageRating', 'updatedAt']))
          ||
          // Action 2: View counter increment (+1)
          (incoming().diff(existing()).affectedKeys().hasOnly(['views', 'updatedAt'])
            && incoming().views == existing().views + 1)
        );
      allow delete: if isVerifiedUser()
        && isValidId(videoId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      // Comments Subcollection (Master Gate Relational Sync)
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(commentId) && existing().videoId == videoId;
        allow list: if isSignedIn() && existing().videoId == videoId;
        allow create: if isVerifiedUser()
          && isValidId(videoId)
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().videoId == videoId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/videos/$(videoId));
        allow update: if isVerifiedUser()
          && isValidId(videoId)
          && isValidId(commentId)
          && isValidComment(incoming())
          && (existing().ownerId == request.auth.uid || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().videoId == existing().videoId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['text'])
          && exists(/databases/$(database)/documents/videos/$(videoId));
        allow delete: if isVerifiedUser()
          && isValidId(videoId)
          && isValidId(commentId)
          && (existing().ownerId == request.auth.uid || isModerator());
      }
    }

    // Playlists Collection
    match /playlists/{playlistId} {
      allow get: if isSignedIn() && isValidId(playlistId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(playlistId)
        && isValidPlaylist(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(playlistId)
        && isValidPlaylist(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'videoIds', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidId(playlistId)
        && existing().ownerId == request.auth.uid;
    }

    // User Profiles Collection (Isolated to Owner)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update profile & preferences
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'isPremium', 'parentalControlMode', 'updatedAt'])
          ||
          // Action 2: Sync cross-device playback progress
          incoming().diff(existing()).affectedKeys().hasOnly(['lastWatchedVideoId', 'lastWatchedProgressSec', 'updatedAt'])
        );
      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // Administration, GM, Admin & Moderator Staff Registry (/admins/{adminId})
    // Enforces strict role hierarchy:
    // - SUPER_ADMIN can manage all staff tiers (SUPER_ADMIN, ADMIN, GM, MODERATOR).
    // - ADMIN can only manage subordinate staff tiers (GM, MODERATOR).
    // - GM and MODERATOR cannot create, update, or delete /admins documents.
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (adminId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (request.auth.token.email == 'creatergame31@gmail.com' || existing().targetUid == request.auth.uid)
        && existing().role in ['SUPER_ADMIN', 'GM', 'ADMIN', 'MODERATOR'];
      allow create: if isValidId(adminId)
        && isValidAdminRole(incoming())
        && incoming().targetUid == adminId
        && incoming().assignedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (isAdmin() && incoming().role in ['GM', 'MODERATOR'])
        );
      allow update: if isValidId(adminId)
        && isValidAdminRole(incoming())
        && incoming().targetUid == existing().targetUid
        && incoming().createdAt == existing().createdAt
        && incoming().assignedByUid == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'permissions', 'assignedByUid', 'updatedAt'])
        && (
          isSuperAdmin()
          || (isAdmin() && existing().role in ['GM', 'MODERATOR'] && incoming().role in ['GM', 'MODERATOR'])
        );
      allow delete: if isValidId(adminId)
        && (
          isSuperAdmin()
          || (isAdmin() && existing().role in ['GM', 'MODERATOR'])
        );
    }

    // Moderation & Contact Tickets (/moderation_tickets/{ticketId}) routed to creatergame31@gmail.com
    match /moderation_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (existing().ownerId == request.auth.uid || isModerator());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || (request.auth.token.email_verified == true && request.auth.token.email == 'creatergame31@gmail.com' && existing().recipientEmail == 'creatergame31@gmail.com'));
      allow create: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidModerationTicket(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'OPEN'
        && incoming().adminReply == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidModerationTicket(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().recipientEmail == existing().recipientEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1a: Admin / SuperAdmin resolution across all categories (including terminal RESOLVED override)
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt']))
          ||
          // Tier 1b: GM resolution on non-terminal GM, MODERATOR, or CONTACT tickets
          (isGM()
            && existing().status != 'RESOLVED'
            && existing().category in ['GM', 'MODERATOR', 'CONTACT']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt']))
          ||
          // Tier 1c: Moderator resolution on non-terminal MODERATOR or CONTACT tickets
          (isModerator()
            && existing().status != 'RESOLVED'
            && existing().category in ['MODERATOR', 'CONTACT']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt']))
          ||
          // Tier 2: Sender updating message before terminal RESOLVED state
          (existing().status != 'RESOLVED'
            && existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'updatedAt']))
        );
      allow delete: if isVerifiedUser()
        && isValidId(ticketId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // User Content Reports (/content_reports/{reportId}) reviewed by Staff from Dashboard
    match /content_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isModerator());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || (request.auth.token.email_verified == true && request.auth.token.email == 'creatergame31@gmail.com' && existing().assignedAdminEmail == 'creatergame31@gmail.com'));
      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidContentReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'OPEN'
        && incoming().resolutionNotes == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(reportId)
        && isValidContentReport(incoming())
        && incoming().targetId == existing().targetId
        && incoming().targetType == existing().targetType
        && incoming().reporterId == existing().reporterId
        && incoming().assignedAdminEmail == existing().assignedAdminEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1a: Admin / SuperAdmin reviewing or overriding any report (including terminal ACTIONED/DISMISSED)
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'severity', 'resolutionNotes', 'updatedAt']))
          ||
          // Tier 1b: GM / Moderator reviewing active non-terminal reports (OPEN or IN_REVIEW)
          (isModerator()
            && existing().status in ['OPEN', 'IN_REVIEW']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'severity', 'resolutionNotes', 'updatedAt']))
          ||
          // Tier 2: Reporter updating details while report is still OPEN
          (existing().status == 'OPEN'
            && existing().reporterId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['details', 'updatedAt']))
        );
      allow delete: if isVerifiedUser()
        && isValidId(reportId)
        && (existing().reporterId == request.auth.uid || isAdmin());
    }
  }
}
