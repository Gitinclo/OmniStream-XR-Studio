# Required for Server-Side Gemini AI Endpoints (/api/gemini/* and /live WebSocket)
# Obtain from https://aistudio.google.com/app/apikey (injected automatically in AI Studio Build)
GEMINI_API_KEY=

# Optional Express Server Configuration (defaults to PORT=3000, NODE_ENV=development)
PORT=3000
NODE_ENV=development

# Optional Scientific API Keys for higher rate limits in Bioscience 3D / Grounding
# NCBI_API_KEY=
# FDA_API_KEY=
# OPENALEX_API_KEY=
# USER_EMAIL=scientist@example.com
